[user]
	name = Ferran Palma
	email = ferranpalmac@gmail.com
	signingkey = ~/.ssh/id_ed25519_github.pub

[gpg]
	# Sign with an SSH key rather than GPG.
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true

[tag]
	gpgsign = true

[init]
	defaultBranch = main

[pull]
	rebase = false

[fetch]
	prune = true

[diff]
	colorMoved = zebra
	algorithm = histogram

[core]
	editor = nvim
	pager = less -FR
